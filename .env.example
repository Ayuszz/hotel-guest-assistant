# Provider order. Each provider is used only if its key is set; with no keys the app runs on the offline mock.
LLM_PROVIDER=cerebras,groq,gemini

# Cerebras (free tier, sub-second). https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-key-here
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_FALLBACK_MODELS=llama3.1-8b

# Groq (free tier, also fast). https://console.groq.com  Optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (free tier, slow and often overloaded at the time of writing). Optional fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.6-flash

# Per-model-attempt timeout and total budget per request (ms)
LLM_TIMEOUT_MS=9000
LLM_TOTAL_BUDGET_MS=24000
