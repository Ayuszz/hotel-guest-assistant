# Supabase project (auth + Postgres for conversations, messages, bookings). Free tier: https://supabase.com
# Project Settings → API for the URL and keys; Project Settings → Database for the pooler connection string.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service-role key: server-only, bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Session pooler connection string (Project Settings → Database → Connection pooling), used only by
# scripts/migrate-supabase.mjs to apply scripts/supabase-schema.sql. Not read by the app at runtime.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# Provider order. Each provider is used only if its key is set; with no keys the app runs on the offline mock.
LLM_PROVIDER=cerebras,groq,gemini

# Cerebras (free tier, sub-second). https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-key-here
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODELS=qwen-3.8-27b

# Groq (free tier, also fast). https://console.groq.com  Optional.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (free tier, slow and often overloaded at the time of writing). Optional fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.6-flash

# Per-model-attempt timeout and total budget per request (ms)
LLM_TIMEOUT_MS=9000
LLM_TOTAL_BUDGET_MS=24000
