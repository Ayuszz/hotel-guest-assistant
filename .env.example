# LLM provider. Leave GEMINI_API_KEY unset (or set LLM_PROVIDER=mock) to run fully offline with the deterministic mock.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PROVIDER=gemini
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-3.6-flash
LLM_TIMEOUT_MS=9000
LLM_TOTAL_BUDGET_MS=24000
